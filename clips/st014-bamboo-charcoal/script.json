  {"who": "narr", "text": "คืนฝนตก สำนักงานนักสืบชิน ได้รับคดีที่แปลกที่สุดในรอบปี", "hl": ["คดีที่แปลกที่สุด"],
   "shot": {"bg": "cityNight", "cast": [["chin", 510, 1000, 1.1, "stand", "determined"]], "fx": ["rain", "tint:#1d2648:0.25"], "cam": "push"},
   "banner": ["stamp", "คดีที่ 7"]},
  {"who": "pan", "text": "ห้องหนูมีกลิ่นอับ ๆ แปลก ๆ ทำความสะอาดแล้วก็ยังไม่หาย ช่วยหนูด้วยค่ะ", "hl": ["กลิ่นอับ"],
   "shot": {"bg": "room:#e7e2d6:#a7a29a", "cast": [["pan", 330, 1000, 1.0, "facepalm", "sad"], ["chin", 780, 1010, 0.95, "stand", "neutral", {"flip": true}]], "props": [["stink", 540, 760, 1]]}},
  {"who": "chin", "text": "ไม่ต้องห่วง จมูกของผมไม่เคยพลาดสักคดี", "hl": ["ไม่เคยพลาด"], "act": {"chin": "hold/smug"},
   "pop": [["prop", "magnifier", 640, 760, 0.3, {"s": 0.6}]]},
  {"who": "narr", "text": "นักสืบชินเรียกผู้ต้องสงสัยมาเข้าแถว ถุงเท้าเมื่อวาน ถังขยะ และรองเท้าผ้าใบ", "hl": ["ผู้ต้องสงสัย"],
   "shot": {"bg": "studio:#3a3966:#2b2a4a", "props": [["sock", 230, 880, 0.9, {"mood": "sad"}], ["trash", 510, 900, 0.9, {"mood": "sad"}], ["shoe", 800, 960, 0.8, {"mood": "sad"}]], "cam": "panR"},
   "pop": [["bubble", "1", 230, 640, 0.25, {"size": 50}], ["bubble", "2", 510, 640, 0.5, {"size": 50}], ["bubble", "3", 800, 640, 0.75, {"size": 50}]]},
  {"who": "chin", "text": "ถุงเท้า ซักแล้ว ถังขยะ เพิ่งเททิ้งเมื่อเช้า รองเท้า ตากแดดมาแล้ว ทุกคนบริสุทธิ์!", "hl": ["บริสุทธิ์"],
   "pop": [["mark", "ok", 230, 640, 0.15], ["mark", "ok", 510, 640, 0.4], ["mark", "ok", 800, 640, 0.65]]},
  {"who": "narr", "text": "แล้วนักสืบก็สังเกตเห็นบางอย่าง หลังตู้เสื้อผ้าที่ไม่มีใครขยับมาหลายเดือน", "hl": ["หลังตู้เสื้อผ้า"],
   "shot": {"bg": "room:#e7e2d6:#a7a29a", "props": [["wardrobe", 400, 860, 0.9], ["mold", 760, 640, 1.0], ["magnifier", 700, 700, 0.9, {"sweep": true}]], "fx": ["dim:0.3"], "cam": "push"}},
  {"who": "chin", "text": "เจอตัวการแล้ว! ผ้าเช็ดตัวเปียกที่ตกอยู่หลังตู้ กับราดำที่ขึ้นเต็มผนัง!", "hl": ["ผ้าเช็ดตัวเปียก", "ราดำ"],
   "shot": {"bg": "room:#e7e2d6:#a7a29a", "props": [["mold", 560, 640, 1.4], ["towel", 560, 1100, 1.2], ["stink", 560, 900, 1.2]], "cam": "zoom:560:860:0.2"},
   "pop": [["big", "ตัวการ!", 510, 480, 0.1, {"col": "#ff3b3b", "size": 140}]]},
  {"who": "narr", "text": "เชื้อราชอบห้องอับชื้น และเมืองไทยความชื้นในอากาศสูงเกินหกสิบเปอร์เซ็นต์แทบทั้งปี มุมที่ลมไม่ผ่าน จึงเป็นบ้านชั้นดีของมัน", "hl": ["อับชื้น", "หกสิบเปอร์เซ็นต์"],
   "shot": {"bg": "studio:#cfe9ff:#a9d3f5", "props": [["clock", 510, 780, 1.1, {"text": "75%", "col": "#7fdcff"}], ["mold", 510, 1060, 0.8]], "fx": ["rain"]},
   "pop": [["big", "ความชื้นสูง = ราชอบ", 510, 470, 0.4, {"size": 80, "col": "#fff"}]]},
  {"who": "narr", "text": "กลิ่นอับที่เราได้กลิ่นกัน ส่วนหนึ่งก็มาจากสารที่เชื้อราปล่อยออกมานี่เอง", "hl": ["เชื้อรา"],
   "pop": [["prop", "stink", 510, 1000, 0.3, {"s": 1.2}]]},
  {"who": "chin", "text": "วิธีปิดคดีมีสามข้อ ข้อหนึ่ง เปิดหน้าต่างให้ลมถ่ายเททุกวัน อย่างน้อยวันละครั้ง", "hl": ["ลมถ่ายเท"],
