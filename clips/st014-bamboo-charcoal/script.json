  {"who": "narr", "text": "หนึ่งสัปดาห์ต่อมา ห้องของป่านหอมสะอาด หายใจได้เต็มปอดอีกครั้ง", "hl": ["หอมสะอาด"],
   "shot": {"bg": "room:#fff6e0:#d39a66", "cast": [["pan", 330, 1000, 1.0, "cheer", "happy"], ["chin", 780, 1010, 0.95, "stand", "smug", {"flip": true}]], "props": [["charcoal", 540, 1180, 0.35, {"front": true}]], "fx": ["sparkle:510:820:330"]},
   "banner": ["tag", "หนึ่งสัปดาห์ต่อมา"]},
