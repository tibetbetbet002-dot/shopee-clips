  {"who": "chin", "text": "ข้อสอง ผ้าเปียกกับผ้าเช็ดตัว ตากให้แห้งสนิทก่อนเก็บ อย่าโยนทิ้งไว้ตามมุมห้อง", "hl": ["แห้งสนิท"],
   "shot": {"bg": "studio:#efe6d2:#cdb892", "cast": [["chin", 800, 1080, 0.72, "point", "smug", {"flip": true}]], "props": [["towel", 400, 760, 1.1]], "fx": ["sparkle:400:760:200"]},
   "pop": [["note", "#ffe15c", 330, 1080, 0.3, {"text": "2 ตากผ้าให้แห้ง", "s": 1.0, "rot": 0.05}]]},
  {"who": "chin", "text": "ข้อสาม วางถ่านไม้ไผ่ไว้ในตู้กับลิ้นชัก ถ่านมีรูพรุนเล็ก ๆ มหาศาล ช่วยดักกลิ่นและความชื้นได้ เดือนละครั้งเอาไปตากแดด ก็ใช้ต่อได้อีก", "hl": ["ถ่านไม้ไผ่", "ตากแดด"],
   "shot": {"bg": "studio:#efe6d2:#cdb892", "cast": [["chin", 800, 1080, 0.72, "cheer", "happy", {"flip": true}]], "props": [["charcoal", 400, 760, 0.9]], "fx": ["sparkle:400:760:280"]},
