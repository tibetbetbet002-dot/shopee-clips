 "lines": [
  {
   "who": "narr",
   "scene": "night",
   "text": "คืนนั้น... เสียงพัดลมในเครื่อง ดังขึ้นเรื่อยๆ",
   "hl": [
    "เสียงพัดลม"
   ]
  },
  {
   "who": "mai",
   "scene": "lag",
   "text": "ทำไมเครื่องช้าลงเรื่อยๆ ล่ะ",
   "hl": [
    "ช้าลง"
   ]
  },
  {
   "who": "narr",
   "scene": "heat",
   "text": "เพราะความร้อนสะสม ชิปจึงลดความเร็วตัวเองลง",
   "hl": [
    "ลดความเร็ว"
   ]
  },
  {
   "who": "narr",
   "scene": "bed",
   "text": "ยิ่งวางบนเตียงหรือหมอน ช่องระบายลม ก็ถูกปิดตาย",
   "hl": [
    "ปิดตาย"
   ]
  },
  {
   "who": "mai",
   "scene": "scream",
   "text": "มันร้อนจนจับไม่ได้แล้ว!",
   "hl": [
    "ร้อน"
   ]
  },
  {
   "who": "narr",
   "scene": "savior",
   "text": "แต่แล้ว... พัดลมรองโน้ตบุ๊กก็มาถึง",
   "hl": [
    "พัดลมรองโน้ตบุ๊ก"
   ]
  },
  {
   "who": "narr",
   "scene": "cool",
   "text": "ยกเครื่องให้ลมผ่าน เป่าความร้อนใต้เครื่องออกไป",
   "hl": [
    "ลมผ่าน"
   ]
  },
  {
   "who": "mai",
   "scene": "relief",
   "text": "เย็นลงแล้ว ราคาก็ไม่แพงด้วย",
   "hl": [
    "เย็นลง"
   ]
  },
  {
   "who": "narr",
   "scene": "cta",
   "text": "ถ้าไม่อยากเจอคืนแบบนี้... ตะกร้าอยู่ด้านล่าง",
   "hl": [
    "ตะกร้า"
   ]
  }
