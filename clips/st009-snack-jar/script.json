  {"who": "narr", "text": "ป๋อง พนักงานสายกินตัวจริง ลิ้นชักโต๊ะของเขาไม่มีเอกสารเลยสักแผ่น มีแต่ขนมเต็มไปหมด", "hl": ["สายกิน", "ขนม"],
   "shot": {"bg": "office", "cast": [["pong", 430, 940, 1.1, "type", "happy"]], "props": [["desk", 520, 1180, 1, {"lx": 240}], ["chips", 170, 1060, 0.5, {"open": true, "front": true}], ["crumbs", 520, 1170, 1, {"front": true}]], "cam": "push"},
   "pop": [["big", "ลิ้นชักขนม", 700, 560, 0.6, {"col": "#ffd23f", "rot": -0.1}]]},
