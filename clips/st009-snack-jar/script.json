  {"who": "narr", "text": "แต่คืนนั้น มีผู้มาเยือนตัวจิ๋ว มดลาดตระเวนหนึ่งตัว เจอเศษขนมของป๋องเข้าให้แล้ว", "hl": ["มดลาดตระเวน"],
   "shot": {"bg": "officeNight", "props": [["crumbs", 650, 1150, 2.2], ["ant", 380, 1100, 1.4, {"id": "ant", "walk": true}]], "cam": "zoom:510:1050:0.2"}},
  {"who": "ant", "text": "รายงานท่านแม่ทัพ! เจอแหล่งอาหารใหญ่ที่สุดในประวัติศาสตร์มดเลยครับ!", "hl": ["แหล่งอาหาร"],
   "shot": {"bg": "studio:#c6f0a8:#9be07a", "props": [["ant", 470, 900, 2.0, {"id": "ant", "helmet": true}]], "fx": ["sparkle:560:860:300"]}},
  {"who": "narr", "text": "มดตัวแรกจะทิ้งกลิ่นพิเศษไว้ตลอดทางกลับรัง มดตัวอื่นก็แค่เดินตามกลิ่นนั้นมา จนเป็นแถวยาวเหยียด", "hl": ["กลิ่นพิเศษ", "เดินตามกลิ่น"],
   "shot": {"bg": "studio:#fff6d6:#ffe9a8", "props": [["antline", 120, 900, 1.2, {"n": 10, "len": 800, "trail": true}], ["chips", 900, 880, 0.5, {"open": true}]], "cam": "push"},
