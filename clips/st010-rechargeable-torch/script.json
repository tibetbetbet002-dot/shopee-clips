  {"who": "narr", "text": "ฟ้าใสเลยเปิดไฟฉายมือถือแทน ผ่านไปครึ่งชั่วโมง แบตเหลือสิบเปอร์เซ็นต์ จะโทรหาใครก็ไม่ได้", "hl": ["สิบเปอร์เซ็นต์"],
   "shot": {"bg": "dark", "cast": [["fahsai", 420, 1000, 1.0, "hold", "tired"]], "props": [["phone", 680, 820, 0.7, {"col": "#fff6c0", "glow": true}], ["battery", 700, 520, 0.8, {"pct": 10}]], "fx": ["dim:0.2"]}},
  {"who": "fahsai", "text": "แบตจะหมดแล้ว! จะโทรบอกอาจารย์ยังไงเนี่ย", "hl": ["แบตจะหมด"], "act": {"fahsai": "facepalm/cry"}},
  {"who": "narr", "text": "สองชั่วโมงต่อมา ไฟกลับมา ฟ้าใสต้องนั่งพิมพ์ใหม่ทั้งหมด จนถึงตีสาม", "hl": ["ตีสาม"],
   "shot": {"bg": "bedroom", "cast": [["fahsai", 340, 950, 1.05, "type", "tired", {"panda": true}]], "props": [["monitor", 730, 1070, 0.68, {"text": "พิมพ์ใหม่...", "front": true}], ["clock", 230, 520, 0.7, {"text": "03:00"}]], "fx": ["screenglow:730:1070"]},
