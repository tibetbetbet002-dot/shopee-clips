  {"who": "narr", "text": "เดือนต่อมา ไฟดับอีกครั้ง แต่ไฟฉุกเฉินข้างโต๊ะ สว่างขึ้นเองทันทีโดยไม่ต้องกดอะไรเลย", "hl": ["สว่างขึ้นเอง"],
   "shot": {"bg": "dark", "cast": [["fahsai", 340, 950, 1.05, "type", "happy"]], "props": [["monitor", 730, 1070, 0.68, {"text": "บันทึกแล้ว", "front": true}], ["emlight", 510, 520, 0.9]], "fx": ["rain"]},
