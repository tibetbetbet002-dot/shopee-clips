 "lines": [
  {"who": "narr", "text": "ห้าทุ่มคืนก่อนส่งรายงานจบ ฟ้าใสพิมพ์มาแล้วเก้าสิบแปดเปอร์เซ็นต์ เหลืออีกนิดเดียวเท่านั้น", "hl": ["เก้าสิบแปด"],
   "shot": {"bg": "bedroom", "cast": [["fahsai", 340, 950, 1.05, "type", "determined"]], "props": [["monitor", 730, 1070, 0.68, {"text": "รายงาน 98%", "front": true}], ["clock", 230, 520, 0.7, {"text": "23:00"}]], "fx": ["screenglow:730:1070"], "cam": "push"},
   "pop": [["big", "98%", 760, 600, 0.6, {"col": "#7bd389"}]]},
  {"who": "fahsai", "text": "อีกหน้าเดียวจบ! ค่อยกดเซฟทีเดียวตอนเสร็จแล้วกัน", "hl": ["ทีเดียว"], "act": {"fahsai": "type/smug"}},
  {"who": "narr", "text": "เปรี้ยง! ฟ้าผ่าลงมาใกล้บ้าน แล้วไฟก็ดับพรึ่บทั้งซอย", "hl": ["ไฟก็ดับ"],
   "shot": {"bg": "storm", "fx": ["lightning", "rain"], "cam": "shake"},
   "pop": [["big", "เปรี้ยง!", 510, 760, 0.05, {"col": "#fff", "size": 170}]]},
  {"who": "narr", "text": "คอมพิวเตอร์ตั้งโต๊ะดับไปพร้อมกับไฟ งานตั้งแต่หกโมงเย็น ยังไม่ได้เซฟเลยสักครั้ง", "hl": ["ยังไม่ได้เซฟ"],
   "shot": {"bg": "dark", "props": [["monitor", 510, 900, 0.9, {"screen": "#05070c"}]], "fx": ["dim:0.5"], "cam": "zoom:510:900:0.2"},
   "pop": [["big", "5 ชั่วโมง = หาย", 510, 470, 0.6, {"col": "#ff3b3b", "size": 90}]]},
  {"who": "fahsai", "text": "ไม่นะ! ห้าชั่วโมงของฉัน!", "hl": ["ห้าชั่วโมง"],
   "shot": {"bg": "dark", "cast": [["fahsai", 510, 1000, 1.25, "facepalm", "cry"]], "fx": ["dim:0.45"], "cam": "shake"}},
  {"who": "narr", "text": "ในความมืด ต้นกล้าน้องชายตัวดี จุดเทียนมาวางไว้ข้างผ้าม่าน", "hl": ["เทียน", "ผ้าม่าน"],
   "shot": {"bg": "dark", "cast": [["kla", 560, 1060, 0.85, "hold", "happy"]], "props": [["curtain", 200, 800, 1.0], ["candle", 330, 1120, 0.9, {"front": true}]], "fx": ["dim:0.3"]}},
  {"who": "kla", "text": "พี่ฟ้าใส ผมเอาไฟมาให้แล้ว สว่างเลย!", "hl": ["สว่างเลย"], "act": {"kla": "cheer/happy"}},
  {"who": "fahsai", "text": "ต้นกล้า! อย่าวางเทียนไว้ใกล้ผ้าม่าน เดี๋ยวไฟไหม้บ้านหมด!", "hl": ["ไฟไหม้"],
   "shot": {"bg": "dark", "cast": [["fahsai", 760, 1000, 1.0, "point", "angry", {"flip": true}], ["kla", 470, 1080, 0.8, "stand", "shock"]], "props": [["curtain", 160, 800, 1.0], ["candle", 280, 1120, 0.9, {"front": true}]], "fx": ["dim:0.25"], "cam": "shake"}},
  {"who": "narr", "text": "ไฟไหม้ในบ้านหลายครั้ง เริ่มจากเทียนที่วางใกล้ผ้าม่าน กองกระดาษ หรือจุดทิ้งไว้แล้วลืม ตอนไฟดับ ใช้ไฟฉายปลอดภัยกว่ามาก", "hl": ["เทียน", "ไฟฉาย"],
   "shot": {"bg": "studio:#ffd6c2:#ffab8a", "props": [["candle", 330, 1000, 1.2], ["torch", 720, 1050, 1.1, {"on": false}]], "cam": "push"},
