  {"who": "boss", "text": "คนขี้ร้อน ย้ายโต๊ะให้ห่างแดดจากหน้าต่าง ใส่เสื้อผ้าบางระบายอากาศ แล้วจิบน้ำเย็นบ่อย ๆ", "hl": ["ขี้ร้อน"],
   "shot": {"bg": "studio:#ffd9b3:#ffb37a", "cast": [["beam", 330, 1040, 0.9, "stand", "happy"]], "props": [["cup", 640, 1000, 1.2, {"steam": false}]]},
