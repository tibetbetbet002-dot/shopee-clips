 "lines": [
  {"who": "narr", "text": "ในออฟฟิศเล็ก ๆ แห่งหนึ่ง มีสงครามที่ไม่มีใครกล้าพูดถึง สงครามแย่งรีโมทแอร์", "hl": ["รีโมทแอร์"],
   "shot": {"bg": "office", "cast": [["beam", 270, 1020, 0.9, "stand", "angry"], ["mint", 770, 1020, 0.9, "stand", "angry", {"flip": true}]], "props": [["ac", 510, 520, 0.8, {"text": "25"}]], "cam": "push"},
   "pop": [["prop", "remote", 510, 900, 0.5, {"s": 0.8}]]},
  {"who": "narr", "text": "ฝั่งซ้ายคือบีม ขี้ร้อนระดับเตาอบ", "hl": ["เตาอบ"], "act": {"beam": "facepalm/tired"}, "fx": ["sweat:270:720", "tint:#ff7a3c:0.12"]},
  {"who": "narr", "text": "ฝั่งขวาคือมิ้นท์ ขี้หนาวระดับเพนกวิน", "hl": ["เพนกวิน"], "act": {"mint": "hold/sad", "beam": "stand/neutral"}, "fx": ["snow", "tint:#7fdcff:0.12"]},
  {"who": "beam", "text": "ร้อนจะละลายแล้ว ขอสิบแปดองศานะทุกคน!", "hl": ["สิบแปดองศา"],
   "shot": {"bg": "studio:#ffb38a:#ff8a5c", "cast": [["beam", 510, 1000, 1.25, "point", "angry", {"sweat": true}]], "fx": ["sweat:510:600"], "cam": "zoom:510:860:0.15"},
   "pop": [["big", "18 องศา", 760, 520, 0.6, {"col": "#7fdcff", "rot": -0.12}]]},
  {"who": "narr", "text": "ติ๊ด ติ๊ด ติ๊ด แอร์ดิ่งลงไปที่สิบแปดองศา", "hl": ["สิบแปด"],
   "shot": {"bg": "office", "props": [["ac", 510, 640, 1.2, {"text": "18"}]], "fx": ["snow"], "cam": "push"}},
  {"who": "mint", "text": "นี่มันขั้วโลกเหนือแล้ว! ขอยี่สิบเจ็ดเถอะ นิ้วจะแข็งแล้ว!", "hl": ["ขั้วโลกเหนือ"],
   "shot": {"bg": "studio:#cdeeff:#9ad7ff", "cast": [["mint", 510, 1000, 1.25, "hold", "cry"]], "fx": ["snow"], "cam": "shake"},
   "pop": [["big", "27 องศา", 760, 520, 0.6, {"col": "#ff8a5c", "rot": 0.1}]]},
  {"who": "narr", "text": "ติ๊ด ติ๊ด ยี่สิบเจ็ด แล้วก็ ติ๊ด ติ๊ด สิบแปด อีกรอบ", "hl": ["ยี่สิบเจ็ด", "สิบแปด"],
   "shot": {"bg": "office", "props": [["ac", 510, 640, 1.2, {"text": "27", "cold": false}]], "cam": "still"}},
  {"who": "narr", "text": "ทั้งวัน รีโมทถูกแย่งไปแย่งมาเกือบห้าสิบรอบ จนปุ่มลูกศรสึก", "hl": ["ห้าสิบรอบ"],
   "shot": {"bg": "studio:#fff0a8:#ffd866", "cast": [["beam", 250, 1040, 0.85, "run", "angry"], ["mint", 790, 1040, 0.85, "run", "angry", {"flip": true}]], "props": [["remote", 510, 760, 0.9, {"rot": 0.4, "text": "18"}]], "fx": ["speed"]},
   "pop": [["big", "50 รอบ!", 510, 460, 0.5, {"col": "#ff3b3b"}]]},
  {"who": "narr", "text": "แล้วงานล่ะ บีมเหงื่อหยดใส่คีย์บอร์ด พิมพ์รายงานผิดเพียบ ส่วนมิ้นท์มือแข็งจนพิมพ์แทบไม่ได้", "hl": ["ผิดเพียบ", "มือแข็ง"],
   "shot": {"bg": "office", "cast": [["beam", 270, 980, 0.85, "type", "tired", {"sweat": true}], ["mint", 770, 980, 0.85, "type", "sad", {"flip": true}]], "props": [["desk", 270, 1170, 0.6, {"lx": 0, "screen": "#ffd6d6", "text": "ERRORR", "front": true}], ["desk", 770, 1170, 0.6, {"lx": 0, "screen": "#d6f0ff", "front": true}]]}},
  {"who": "narr", "text": "มีงานวิจัยในออฟฟิศจริงพบว่า ห้องเย็นราวยี่สิบองศา คนพิมพ์ผิดมากกว่าห้องยี่สิบห้าองศาเกินเท่าตัว", "hl": ["ยี่สิบองศา", "เกินเท่าตัว"],
   "shot": {"bg": "studio:#c9f0ff:#a8e4ff", "cam": "push"},
   "pop": [["bubble", "20 องศา = พิมพ์ผิดเยอะ", 510, 560, 0.35, {"size": 56, "fill": "#cdeeff"}], ["bubble", "25 องศา = ผิดน้อยกว่าครึ่ง", 510, 820, 0.7, {"size": 56, "fill": "#c9f7c9"}]]},
  {"who": "narr", "text": "และหลายคนไม่รู้ว่า แอร์ออฟฟิศมักถูกตั้งตามร่างกายผู้ชายวัยสี่สิบ ผู้หญิงหรือคนตัวเล็กหลายคน เลยรู้สึกหนาวกว่า", "hl": ["ผู้ชายวัยสี่สิบ"],
   "shot": {"bg": "studio:#efe3ff:#dcc8ff", "cast": [["boss", 330, 1020, 0.9, "stand", "neutral"], ["mint", 730, 1060, 0.75, "hold", "sad", {"flip": true}]], "fx": ["snow"]},
   "pop": [["bubble", "มาตรฐานเก่า", 330, 520, 0.2, {"size": 48}]]},
  {"who": "boss", "text": "หยุดเดี๋ยวนี้! รีโมทนี้ถูกยึด ตั้งแต่วันนี้ แอร์อยู่ที่ยี่สิบห้าองศาตลอด!", "hl": ["ถูกยึด", "ยี่สิบห้า"],
   "shot": {"bg": "office", "cast": [["boss", 510, 1000, 1.05, "point", "angry"], ["beam", 180, 1080, 0.7, "stand", "shock"], ["mint", 850, 1080, 0.7, "stand", "shock", {"flip": true}]], "cam": "shake"},
