   "shot": {"bg": "studio:#d9f7ff:#a8ecff", "cast": [["tech", 800, 1080, 0.75, "point", "determined", {"flip": true}]]},
   "pop": [["note", "#ff8fc1", 300, 470, 0.05, {"text": "1 ปิดเครื่อง", "s": 1.05, "rot": -0.05}], ["note", "#ffe15c", 300, 700, 0.25, {"text": "2 ถอดสายชาร์จ", "s": 1.05, "rot": 0.05}], ["note", "#8fd3ff", 300, 930, 0.45, {"text": "3 ห้ามเปิดซ้ำ", "s": 1.05, "rot": -0.04}], ["note", "#9be7a0", 560, 640, 0.65, {"text": "4 คว่ำแล้วส่งช่าง", "s": 1.05, "rot": 0.06}]]},
  {"who": "narr", "text": "ช่างใช้เวลาทั้งคืน และโชคยังเข้าข้าง เครื่องเปิดติด ไฟล์ยังอยู่ครบ", "hl": ["เปิดติด"],
   "shot": {"bg": "shop", "cast": [["tech", 330, 1000, 1.0, "type", "determined"], ["oat", 790, 1030, 0.95, "cheer", "happy", {"flip": true}]], "props": [["laptop", 330, 1160, 0.6, {"text": "เปิดติดแล้ว", "ts": 46, "front": true}]], "fx": ["sparkle:330:1000:180"]}},
  {"who": "tech", "text": "รอบนี้ฟลุกนะน้อง ความเสียหายที่ช่างเจอบ่อยมากของโน้ตบุ๊ก ก็คือตกกระแทกกับโดนน้ำนี่แหละ", "hl": ["ตกกระแทก", "โดนน้ำ"], "act": {"tech": "shrug/smug", "oat": "stand/shock"}},
  {"who": "tech", "text": "พกโน้ตบุ๊กทุกครั้ง ใส่ซองที่มีฟองน้ำกันกระแทกก่อน แล้วค่อยใส่กระเป๋า ผ้ากันน้ำยังช่วยกันละอองฝนได้อีกชั้น", "hl": ["ฟองน้ำกันกระแทก", "ผ้ากันน้ำ"],
   "shot": {"bg": "studio:#d6e2ff:#9fb4f0", "props": [["sleeve", 510, 820, 1.2, {"rot": -0.05}]], "fx": ["sparkle:510:820:320"]},
   "pop": [["bubble", "กันกระแทก", 330, 520, 0.4, {"size": 52, "fill": "#ffe15c"}], ["bubble", "กันละอองน้ำ", 690, 1110, 0.7, {"size": 52, "fill": "#9fe3ff"}]]},
  {"who": "tech", "text": "อีกอย่าง สำรองไฟล์สำคัญขึ้นคลาวด์ไว้ด้วย เครื่องพังยังซื้อใหม่ได้ แต่งานสามเดือนซื้อคืนไม่ได้นะ", "hl": ["สำรองไฟล์"],
