 "lines": [
  {"who": "narr", "text": "แปดโมงครึ่ง โอ๊ตมีนัดพรีเซนต์งานกับลูกค้ารายใหญ่ตอนเก้าโมง และงานทั้งหมดอยู่ในโน้ตบุ๊กเครื่องเดียว", "hl": ["เก้าโมง", "เครื่องเดียว"],
   "shot": {"bg": "street", "cast": [["oat", 470, 1000, 1.0, "hold", "determined"]], "props": [["tote", 700, 1080, 0.6, {"front": true}], ["clock", 780, 560, 0.7, {"text": "08:30"}]], "cam": "push"}},
  {"who": "oat", "text": "พี่วิน! ไปตึกใหญ่ข้างหน้า ด่วนที่สุดเลยครับ!", "hl": ["ด่วนที่สุด"], "act": {"oat": "wave/shock"}},
  {"who": "win", "text": "จับแน่น ๆ นะน้อง พี่ขอซิ่งหน่อย!", "hl": ["ซิ่ง"],
   "shot": {"bg": "street", "cast": [["win", 590, 860, 0.7, "sit", "smug"], ["oat", 420, 880, 0.7, "sit", "shock", {"flip": true}]], "props": [["bike", 520, 1080, 1.0, {"go": true, "front": true}]], "fx": ["speed"], "cam": "shake"}},
  {"who": "narr", "text": "แต่ฟ้าไม่เป็นใจ ฝนตกลงมาเหมือนมีคนเทน้ำจากถัง", "hl": ["เทน้ำจากถัง"],
   "shot": {"bg": "street:night", "cast": [["win", 590, 860, 0.7, "sit", "tired"], ["oat", 420, 880, 0.7, "sit", "shock", {"flip": true}]], "props": [["bike", 520, 1080, 1.0, {"go": true, "front": true}]], "fx": ["rain", "lightning", "tint:#2b3a67:0.25"]}},
  {"who": "oat", "text": "กระเป๋าผ้าใบนี้กันน้ำไม่ได้เลย โน้ตบุ๊กเปียกแน่!", "hl": ["เปียกแน่"], "act": {"oat": "facepalm/cry"}},
  {"who": "narr", "text": "แล้วพี่วินก็เบรกกะทันหัน กระเป๋าหลุดมือ ตกลงไปในแอ่งน้ำกลางถนน", "hl": ["เบรกกะทันหัน", "แอ่งน้ำ"],
   "shot": {"bg": "street:night", "props": [["puddle", 510, 1200, 1.0, {"splash": true}], ["tote", 510, 1150, 0.7, {"wet": true, "rot": 0.6, "front": true}]], "fx": ["rain", "tint:#2b3a67:0.25"], "cam": "shake"},
   "pop": [["big", "ตูม!", 510, 560, 0.55, {"col": "#9fe3ff", "size": 160}]]},
  {"who": "narr", "text": "โอ๊ตกดปุ่มเปิดเครื่อง หนึ่งครั้ง สองครั้ง สามครั้ง จอยังดำสนิท", "hl": ["จอยังดำ"],
   "shot": {"bg": "dark", "props": [["laptop", 510, 1060, 1.3, {"off": true, "wet": true}]], "cam": "zoom:510:900:0.2"},
   "pop": [["big", "1", 300, 520, 0.2, {"col": "#fff"}], ["big", "2", 510, 520, 0.4, {"col": "#fff"}], ["big", "3", 720, 520, 0.6, {"col": "#ff3b3b"}]]},
  {"who": "oat", "text": "จบแล้ว งานสามเดือน ไม่ได้สำรองไว้ที่ไหนเลย!", "hl": ["ไม่ได้สำรอง"],
   "shot": {"bg": "studio:#9fb4f0:#6f86c9", "cast": [["oat", 510, 1000, 1.3, "stand", "cry"]], "fx": ["rain"], "cam": "zoom:510:860:0.2"}},
  {"who": "narr", "text": "เขาวิ่งฝ่าฝนไปร้านซ่อมคอมที่ใกล้ที่สุด ทั้งที่ยังตัวเปียกโชก", "hl": ["ร้านซ่อมคอม"],
   "shot": {"bg": "shop", "cast": [["tech", 330, 1000, 1.0, "stand", "neutral"], ["oat", 790, 1030, 0.95, "run", "cry", {"flip": true, "enter": "right"}]], "props": [["table", 330, 1160, 1, {"col": "#e9e2d4", "front": true}]]}},
  {"who": "oat", "text": "พี่ครับ ผมควรเอาไดร์เป่าผมเป่าให้แห้ง หรือเอาไปฝังในข้าวสารดีครับ", "hl": ["ไดร์เป่าผม", "ข้าวสาร"], "act": {"oat": "shrug/sad"}},
  {"who": "tech", "text": "อย่าเด็ดขาด! ลมร้อนทำชิ้นส่วนเสียหายได้ ส่วนข้าวสาร ช่วยได้น้อยกว่าที่คิดเยอะ", "hl": ["อย่าเด็ดขาด"], "act": {"tech": "point/angry"},
   "pop": [["mark", "x", 560, 560, 0.25], ["mark", "x", 680, 560, 0.6]]},
