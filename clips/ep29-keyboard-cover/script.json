 "lines": [
  {
   "who": "narr",
   "scene": "era",
   "text": "หกสิบห้าล้านปีก่อน คีย์บอร์ดยังอยู่กันอย่างสงบสุข",
   "hl": [
    "สงบสุข"
   ]
  },
  {
   "who": "dino",
   "scene": "meteor",
   "text": "แย่แล้ว! อุกกาบาตแก้วกาแฟกำลังตกลงมา!",
   "hl": [
    "อุกกาบาตแก้วกาแฟ"
   ]
  },
  {
   "who": "narr",
   "scene": "fact",
   "text": "น้ำหกใส่คีย์บอร์ด เป็นสาเหตุเครื่องเสียที่พบได้บ่อย",
   "hl": [
    "น้ำหก"
   ]
  },
  {
   "who": "dino",
   "scene": "why",
   "text": "น้ำหวานจะเหนียวติดใต้ปุ่ม ส่วนน้ำเปล่าอาจซึมลงไปถึงแผงวงจร",
   "hl": [
    "แผงวงจร"
   ]
  },
  {
   "who": "dino",
   "scene": "shield",
   "text": "โล่ป้องกัน! ซิลิโคนคลุมคีย์บอร์ด!",
   "hl": [
    "ซิลิโคนคลุม"
   ]
  },
  {
   "who": "narr",
   "scene": "save",
   "text": "น้ำและฝุ่นค้างอยู่บนแผ่น เช็ดออกได้ง่าย",
   "hl": [
    "เช็ดออกได้ง่าย"
   ]
  },
  {
   "who": "narr",
   "scene": "tip",
   "text": "ถ้าน้ำหก ให้ปิดเครื่อง ถอดปลั๊ก แล้วคว่ำคีย์บอร์ดทันที",
   "hl": [
    "ปิดเครื่อง"
   ]
  },
  {
   "who": "dino",
   "scene": "bonus",
   "text": "ห้ามเปิดเครื่องจนกว่าจะแห้งสนิท และอย่าเป่าลมร้อนจัด!",
   "hl": [
    "แห้งสนิท"
   ]
  },
  {
   "who": "dino",
   "scene": "live",
   "text": "คีย์บอร์ดรอดแล้ว! ราคาหลักสิบเอง",
   "hl": [
    "รอดแล้ว"
   ]
  },
  {
   "who": "narr",
   "scene": "cta",
   "text": "ฟอสซิลชิ้นนี้ ขุดได้ที่ตะกร้าด้านล่าง",
   "hl": [
    "ตะกร้า"
   ]
  }
 ],
