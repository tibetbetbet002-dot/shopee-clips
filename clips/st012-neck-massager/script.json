 "lines": [
  {"who": "narr", "text": "ต่อ โปรแกรมเมอร์วัยยี่สิบแปด นั่งก้มหน้าจอโน้ตบุ๊กวันละสิบสองชั่วโมง", "hl": ["สิบสองชั่วโมง"],
   "shot": {"bg": "office", "cast": [["tor", 430, 990, 1.05, "type", "tired", {"rot": 0.35, "bob": false}]], "props": [["desk", 560, 1200, 1, {"lx": 160, "w": 700}]], "cam": "push"}},
  {"who": "narr", "text": "จนวันหนึ่ง เพื่อนในทีมแอบตั้งฉายาให้ว่า มนุษย์เต่า", "hl": ["มนุษย์เต่า"],
   "pop": [["big", "มนุษย์เต่า", 510, 520, 0.6, {"col": "#c6ff7a", "rot": -0.08}]]},
  {"who": "tor", "text": "ใครว่าผมคอยื่น ผมแค่ตั้งใจทำงานมากเฉย ๆ", "hl": ["คอยื่น"], "act": {"tor": "type/smug"}},
  {"who": "narr", "text": "คืนนั้น ต่อปวดคอจนต้องแปะแผ่นแก้ปวดแล้วหลับไป ก่อนจะฝันแปลก ๆ", "hl": ["ปวดคอ", "ฝันแปลก"],
   "shot": {"bg": "bedroom", "props": [["bed", 540, 1260, 1, {"who": "tor", "face": "tired", "col": "#5c7cfa"}]], "fx": ["zzz:380:900"], "cam": "push"}},
  {"who": "narr", "text": "เต่าทวดอายุร้อยปี ค่อย ๆ คลานเข้ามาหาเขาในฝัน", "hl": ["เต่าทวด"],
   "shot": {"bg": "dream", "props": [["turtle", 420, 1000, 1.0, {"cane": true}]], "fx": ["sparkle:510:860:360"]}},
  {"who": "turtle", "text": "เจ้าหนุ่ม เลิกขโมยท่าคอยื่นของข้าได้แล้ว อายุร้อยปี ข้ายังไม่ปวดคอเท่าเจ้าเลย", "hl": ["ขโมยท่า"], "cam": "zoom:660:960:0.15"},
  {"who": "tor", "text": "ผมแค่ก้มนิดเดียวเองนะครับคุณเต่า", "hl": ["นิดเดียว"],
   "shot": {"bg": "dream", "cast": [["tor", 760, 1020, 0.85, "shrug", "neutral", {"flip": true}]], "props": [["turtle", 300, 1040, 0.75, {"cane": true}]]}},
  {"who": "turtle", "text": "หัวคนหนักราวห้ากิโล แต่พอก้มสิบห้าองศา คอต้องรับน้ำหนักเหมือนสิบสองกิโล ถ้าก้มหกสิบองศา ก็เหมือนแบกเด็กเจ็ดขวบไว้บนคอ", "hl": ["ห้ากิโล", "เด็กเจ็ดขวบ"],
   "shot": {"bg": "studio:#efe3ff:#dcc8ff", "props": [["heads", 510, 860, 1.05]], "cam": "push"},
   "pop": [["big", "ก้มมาก = คอแบกหนัก", 510, 430, 0.15, {"size": 80, "col": "#fff"}]]},
  {"who": "tor", "text": "เด็กเจ็ดขวบ!? มิน่าล่ะ บ่ากับคอผมแข็งเป็นหินทุกเย็นเลย", "hl": ["แข็งเป็นหิน"],
   "shot": {"bg": "studio:#ffd6d6:#ffb3b3", "cast": [["tor", 510, 1000, 1.2, "facepalm", "shock", {"sweat": true}]], "cam": "zoom:510:860:0.15"}},
  {"who": "turtle", "text": "ฟังนะ ข้อหนึ่ง ยกจอให้ขอบบนอยู่ระดับสายตา คอจะได้ตั้งตรง ไม่ต้องก้มทั้งวัน", "hl": ["ระดับสายตา"],
   "shot": {"bg": "studio:#d9f7c9:#9be07a", "cast": [["tor", 330, 990, 1.0, "type", "happy"]], "props": [["monitor", 700, 860, 0.7, {"text": "ระดับตา"}], ["eyeline", 510, 830, 1]]},
   "pop": [["note", "#ffe15c", 330, 480, 0.2, {"text": "1 จอระดับตา", "s": 1.05, "rot": -0.05}]]},
  {"who": "turtle", "text": "ข้อสอง ฝึกท่าเก็บคาง ดันคางถอยไปข้างหลังเบา ๆ ค้างห้าวินาที ทำสิบครั้ง", "hl": ["เก็บคาง"],
   "shot": {"bg": "studio:#d9f7c9:#9be07a", "cast": [["tor", 510, 1000, 1.15, "stand", "determined", {"flip": true}]], "props": [["arrow", 800, 820, 0.8, {"anim": true, "flip": true}]]},
   "pop": [["note", "#8fd3ff", 280, 480, 0.2, {"text": "2 เก็บคาง x10", "s": 1.05, "rot": 0.05}]]},
  {"who": "turtle", "text": "ข้อสาม ตอนพัก ใช้ไม้นวดกดคลายจุดตึงที่บ่ากับต้นคอ แต่ถ้าปวดร้าวลงแขนหรือชา ต้องไปหาหมอนะ", "hl": ["ไม้นวด", "ไปหาหมอ"],
