   "pop": [["note", "#ff8fc1", 800, 480, 0.15, {"text": "3 นวดคลาย", "s": 1.05, "rot": -0.04}]]},
  {"who": "narr", "text": "ต่อสะดุ้งตื่น แล้วรีบทำตามทุกข้อตั้งแต่เช้า", "hl": ["ทุกข้อ"],
