 "lines": [
  {
   "who": "lord",
   "scene": "palace",
   "text": "ท่านหญิง ปลั๊กพ่วงในตำหนักร้อนจนควันขึ้นแล้ว!",
   "hl": [
    "ควันขึ้น"
   ]
  },
  {
   "who": "lady",
   "scene": "cause",
   "text": "เพราะเสียบอุปกรณ์กินไฟหลายชิ้น บนปลั๊กพ่วงราคาถูกไร้มาตรฐานเพคะ",
   "hl": [
    "ไร้มาตรฐาน"
   ]
  },
  {
   "who": "lord",
   "scene": "law",
   "text": "ราชโองการ ปลั๊กพ่วงต้องมีเครื่องหมาย มอก. และมีฟิวส์ตัดไฟ",
   "hl": [
    "มอก."
   ]
  },
  {
   "who": "lady",
   "scene": "why",
   "text": "เพราะเมื่อกระแสไฟเกินกำลัง สายไฟจะร้อนขึ้น ฉนวนละลาย จนเกิดประกายไฟได้เพคะ",
   "hl": [
    "ประกายไฟ"
   ]
  },
  {
   "who": "lady",
   "scene": "gift",
   "text": "หม่อมฉันจึงนำปลั๊กพ่วงมาตรฐาน มีสวิตช์แยก และระบบตัดไฟมาถวาย",
   "hl": [
    "ระบบตัดไฟ"
   ]
  },
  {
   "who": "lord",
   "scene": "check",
   "text": "อย่าลืมดูกำลังไฟรวม ไม่ให้เกินที่ปลั๊กรองรับ",
   "hl": [
    "กำลังไฟรวม"
   ]
  },
  {
   "who": "lord",
   "scene": "tip",
   "text": "อีกข้อ อย่าเสียบปลั๊กพ่วงต่อกันหลายทอด และอย่าวางใต้พรมหรือผ้าห่ม",
   "hl": [
    "ต่อกันหลายทอด"
   ]
  },
  {
   "who": "lady",
   "scene": "bonus",
   "text": "ถ้าปลั๊กอุ่นผิดปกติ มีกลิ่นไหม้ ให้หยุดใช้ทันทีเพคะ",
   "hl": [
    "กลิ่นไหม้"
   ]
  },
  {
   "who": "lady",
   "scene": "peace",
   "text": "ตำหนักปลอดภัย ราคาก็ไม่แพงเพคะ",
   "hl": [
    "ปลอดภัย"
   ]
  },
  {
   "who": "lord",
   "scene": "cta",
   "text": "ผู้ใดสนใจ ไปที่ตะกร้าด้านล่าง",
   "hl": [
    "ตะกร้า"
   ]
  }
 ],
